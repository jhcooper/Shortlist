# Copy to .env (never committed) for local runs. In GitHub Actions, add the SECRET ones as repository secrets.
# Nothing here is needed by today's Claude-scheduled run, which gets its accounts through Claude connectors.

# --- where your personal config lives (a private folder or private repo; see config.example/) ---
CONFIG_DIR=../job-agent-me
# STATE_DIR=../job-agent-me/state      # optional; defaults to $CONFIG_DIR/state

# --- API version (planned) ---
# SECRET: your Anthropic API key (each user brings their own). Actions secret only.
ANTHROPIC_API_KEY=
# Supabase project URL (not secret).
SUPABASE_URL=
# PUBLIC by design: the browser key the tracker page uses. Row-level security must be on for every table.
SUPABASE_ANON_KEY=
# Your user id in Supabase Auth (Authentication -> Users). Not secret. Telemetry and tracker rows are written for it.
SUPABASE_OWNER_ID=
# SECRET: bypasses row-level security. Only the scheduled job uses it; never put it in the page or a log.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET: Gmail access for reading application emails and sending the digest (OAuth client in "In production"
# status; a "Testing" client's refresh token expires after 7 days).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
